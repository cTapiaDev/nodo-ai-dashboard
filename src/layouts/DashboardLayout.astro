---
import '../styles/global.css';
import '../styles/neumorphism.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="h-full bg-chassis font-sans antialiased overflow-x-hidden selection:bg-[#607931] selection:text-white">
    
    <div class="flex h-screen w-screen overflow-hidden relative">
      
      <!-- Sidebar Lateral -->
      <aside id="sidebar" style="background-color: #607931; color: #ffffff;" class="absolute md:relative inset-y-0 h-screen left-0 z-50 w-72 flex flex-col p-5 shrink-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 shadow-2xl md:shadow-none border-r border-black/10">
        
        <div class="flex items-center justify-between pb-5 border-b border-white/15">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center font-display font-bold text-white text-lg" style="background-color: #607931; box-shadow: 3px 3px 6px #4d6027, -3px -3px 6px #73923b;">
              IA
            </div>
            <div>
              <h1 class="font-display font-bold text-sm tracking-wide text-white">IA APLICADA</h1>
              <p class="text-[10px] text-white/80 font-mono">Laboratorio de Prompts</p>
            </div>
          </div>
          <button id="close-menu-btn" class="md:hidden p-2 rounded-xl text-white hover:bg-white/10 cursor-pointer">
            ✕
          </button>
        </div>

        <slot name="sidebar-nav" />

        <div class="mt-auto pt-4 border-t border-white/15 flex flex-col gap-2 shrink-0">
          <p class="text-[10px] font-mono text-white/70 uppercase tracking-wider px-1">Plataformas</p>
          <div class="grid grid-cols-3 gap-2">
            <a href="https://claude.ai" target="_blank" rel="noreferrer" class="text-center py-2 rounded-xl text-xs font-semibold text-white transition-all hover:opacity-90 active:scale-95" style="background-color: #607931; box-shadow: 3px 3px 6px #4d6027, -3px -3px 6px #73923b;">Claude</a>
            <a href="https://gemini.google.com" target="_blank" rel="noreferrer" class="text-center py-2 rounded-xl text-xs font-semibold text-white transition-all hover:opacity-90 active:scale-95" style="background-color: #607931; box-shadow: 3px 3px 6px #4d6027, -3px -3px 6px #73923b;">Gemini</a>
            <a href="https://chatgpt.com" target="_blank" rel="noreferrer" class="text-center py-2 rounded-xl text-xs font-semibold text-white transition-all hover:opacity-90 active:scale-95" style="background-color: #607931; box-shadow: 3px 3px 6px #4d6027, -3px -3px 6px #73923b;">GPT</a>
          </div>
        </div>
      </aside>

      <div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden md:hidden backdrop-blur-xs"></div>

      <!-- Área de Contenido Principal -->
      <main class="flex-1 flex flex-col h-full overflow-hidden w-full">
        
        <!-- Navbar Componente Modular -->
        <Navbar />

        <div class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
          <slot />
        </div>

      </main>
    </div>

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      const htmlElement = document.documentElement;
      const sidebar = document.getElementById('sidebar');
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const closeMenuBtn = document.getElementById('close-menu-btn');
      const backdrop = document.getElementById('sidebar-backdrop');

      if (localStorage.getItem('theme') === 'dark') {
        htmlElement.classList.add('dark');
      } else {
        htmlElement.classList.remove('dark');
      }

      themeToggle?.addEventListener('click', () => {
        htmlElement.classList.toggle('dark');
        localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
      });

      function toggleSidebar() {
        sidebar?.classList.toggle('-translate-x-full');
        backdrop?.classList.toggle('hidden');
      }

      mobileMenuBtn?.addEventListener('click', toggleSidebar);
      closeMenuBtn?.addEventListener('click', toggleSidebar);
      backdrop?.addEventListener('click', toggleSidebar);
    </script>
  </body>
</html>