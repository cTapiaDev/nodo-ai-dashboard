---
/* 🟢 Página Principal: Dashboard Neomórfico del Curso */
import DashboardLayout from '../layouts/DashboardLayout.astro';
import SidebarNav from '../components/SidebarNav.astro';
import ClassView from '../components/ClassView.astro';
import { courseData } from '../data/curso';

const allUnits = courseData || [];
const realUnits = allUnits.filter((unit) => !unit.unitId.toLowerCase().includes('anexo'));

const initialUnit = realUnits.length > 0 ? realUnits[realUnits.length - 1] : null;
const initialClass = initialUnit && initialUnit.classes.length > 0 
  ? initialUnit.classes[initialUnit.classes.length - 1] 
  : null;
---

<DashboardLayout title="NODO IA // Dashboard de Prompts y Casos de Trabajo">
  <!-- Inyectar el menú lateral en el slot del Layout -->
  <SidebarNav slot="sidebar-nav" />

  <!-- Renderizar la vista principal de la Clase 1 por defecto -->
  <ClassView initialClassNumber="Clase 01" />
</DashboardLayout>