---
import { courseData, type ClassModule } from '../data/curso';

interface Props {
  initialClassNumber?: string;
}

const { initialClassNumber = 'Clase 01' } = Astro.props;
const currentClass: ClassModule = courseData[0].classes.find(c => c.classNumber === initialClassNumber) || courseData[0].classes[0];
---

<div id="class-view-container" class="flex flex-col gap-6 w-full pb-10" data-classes={JSON.stringify(courseData[0].classes)}>
  
  <!-- Sección de Guías Teóricas -->
  <div class="flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="w-2 h-5 rounded-full bg-[#607931]"></span>
      <h3 class="font-display font-bold text-sm md:text-base tracking-wide uppercase text-text-muted">Conceptos Clave de la Sesión</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="guides-grid">
      {currentClass.guides.map((guide, i) => (
        <div class="neu-raised p-5 rounded-2xl flex flex-col justify-between gap-3 border border-transparent">
          <span class="font-mono text-xs text-[#607931] font-bold">0{i+1} // CONCEPTO</span>
          <p class="text-sm md:text-base font-sans leading-relaxed text-text-main">{guide}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Sección de Prompts -->
  <div class="flex flex-col gap-4 mt-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-5 rounded-full bg-[#607931]"></span>
        <h3 class="font-display font-bold text-sm md:text-base tracking-wide uppercase text-text-muted">Banco de Prompts Interactivos</h3>
      </div>
      <span id="prompts-counter" class="text-xs font-mono neu-inset px-4 py-1.5 rounded-full text-text-muted">
        {currentClass.prompts.length} Disponibles
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="prompts-grid">
      {currentClass.prompts.map((prompt) => (
        <div class="neu-raised p-5 md:p-7 rounded-3xl flex flex-col gap-5 justify-between">
          
          <div class="flex items-start justify-between gap-3">
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-sm font-bold text-[#607931] px-2.5 py-1 neu-badge rounded-lg">
                  {prompt.code}
                </span>
                <span class="text-xs font-mono text-text-muted uppercase tracking-wider">
                  {prompt.tool}
                </span>
              </div>
              <h4 class="font-display font-bold text-base md:text-lg mt-1">{prompt.title}</h4>
            </div>
          </div>

          <p class="text-sm text-text-muted font-sans italic border-l-2 border-[#607931]/50 pl-3.5">
            {prompt.context}
          </p>

          <div class="neu-inset p-4 md:p-5 rounded-2xl relative overflow-x-hidden">
            <pre class="font-mono text-sm text-text-main whitespace-pre-wrap leading-relaxed select-all font-normal">{prompt.promptText}</pre>
          </div>

          <button
            class="copy-prompt-btn neu-raised active:neu-pressed w-full py-3.5 px-5 rounded-2xl font-display font-bold text-sm flex items-center justify-center gap-2.5 transition-all hover:text-[#607931] cursor-pointer"
            data-clipboard-text={prompt.promptText}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span class="btn-text">Copiar Prompt</span>
            <span class="copy-led w-2.5 h-2.5 rounded-full bg-gray-400 ml-2 transition-all shrink-0"></span>
          </button>

        </div>
      ))}
    </div>
  </div>

</div>

<script>
  import type { ClassModule } from '../data/curso';

  function initCopyButtons() {
    const copyButtons = document.querySelectorAll('.copy-prompt-btn');
    copyButtons.forEach(btn => {
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-clipboard-text') || '';
        const btnText = btn.querySelector('.btn-text');
        const led = btn.querySelector('.copy-led') as HTMLElement;

        try {
          await navigator.clipboard.writeText(textToCopy);
          btn.classList.add('neu-pressed');
          if (btnText) btnText.textContent = '¡Copiado!';
          if (led) {
            led.style.backgroundColor = '#10B981';
            led.style.boxShadow = '0 0 8px #10B981';
          }
          setTimeout(() => {
            btn.classList.remove('neu-pressed');
            if (btnText) btnText.textContent = 'Copiar Prompt';
            if (led) {
              led.style.backgroundColor = '#9CA3AF';
              led.style.boxShadow = 'none';
            }
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    });
  }

  initCopyButtons();

  window.addEventListener('change-class', ((e: CustomEvent) => {
    const { classNum } = e.detail;
    const container = document.getElementById('class-view-container');
    if (!container) return;

    const classesData: ClassModule[] = JSON.parse(container.getAttribute('data-classes') || '[]');
    const selectedClass = classesData.find(c => c.classNumber === classNum);
    if (!selectedClass) return;

    const guidesGrid = document.getElementById('guides-grid');
    if (guidesGrid) {
      guidesGrid.innerHTML = selectedClass.guides.map((guide, i) => `
        <div class="neu-raised p-5 rounded-2xl flex flex-col justify-between gap-3 border border-transparent">
          <span class="font-mono text-xs text-[#607931] font-bold">0${i+1} // CONCEPTO</span>
          <p class="text-sm md:text-base font-sans leading-relaxed text-text-main">${guide}</p>
        </div>
      `).join('');
    }

    const counter = document.getElementById('prompts-counter');
    if (counter) {
      counter.textContent = `${selectedClass.prompts.length} Disponibles`;
    }

    const promptsGrid = document.getElementById('prompts-grid');
    if (promptsGrid) {
      promptsGrid.innerHTML = selectedClass.prompts.map(prompt => `
        <div class="neu-raised p-5 md:p-7 rounded-3xl flex flex-col gap-5 justify-between">
          <div class="flex items-start justify-between gap-3">
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-sm font-bold text-[#607931] px-2.5 py-1 neu-badge rounded-lg">
                  ${prompt.code}
                </span>
                <span class="text-xs font-mono text-text-muted uppercase tracking-wider">
                  ${prompt.tool}
                </span>
              </div>
              <h4 class="font-display font-bold text-base md:text-lg mt-1">${prompt.title}</h4>
            </div>
          </div>
          <p class="text-sm text-text-muted font-sans italic border-l-2 border-[#607931]/50 pl-3.5">
            ${prompt.context}
          </p>
          <div class="neu-inset p-4 md:p-5 rounded-2xl relative overflow-x-hidden">
            <pre class="font-mono text-sm text-text-main whitespace-pre-wrap leading-relaxed select-all font-normal">${prompt.promptText}</pre>
          </div>
          <button
            class="copy-prompt-btn neu-raised active:neu-pressed w-full py-3.5 px-5 rounded-2xl font-display font-bold text-sm flex items-center justify-center gap-2.5 transition-all hover:text-[#607931] cursor-pointer"
            data-clipboard-text="${prompt.promptText.replace(/"/g, '&quot;')}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span class="btn-text">Copiar Prompt</span>
            <span class="copy-led w-2.5 h-2.5 rounded-full bg-gray-400 ml-2 transition-all shrink-0"></span>
          </button>
        </div>
      `).join('');

      initCopyButtons();
    }
  }) as EventListener);

  // Escuchar el evento de búsqueda emitido por el Navbar
  window.addEventListener('filter-prompts', ((e: CustomEvent) => {
    const { query } = e.detail;
    const promptCards = document.querySelectorAll('#prompts-grid > div');
    
    promptCards.forEach(card => {
      const textContent = card.textContent?.toLowerCase() || '';
      if (textContent.includes(query)) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }) as EventListener);
</script>